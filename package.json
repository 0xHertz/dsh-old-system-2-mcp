{
  "name": "@local/dsh-mcp-gui",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "description": "Graphical external system connections and MCP groups for DeepSeek Harness: server CRUD, connection tests, browser login capture, custom CA, and automatic credential refresh.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
